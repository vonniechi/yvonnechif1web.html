  <script>
// ==========================================================================
// Yvonne Margaret S. Chi — Portfolio
//   1. Mobile navigation toggle
//   2. Active nav-link highlighting on scroll
//   3. Skill bar reveal animation
//   4. Live-timing sidebar (sample/decorative telemetry widget)
//   5. Liquid-glass card tilt
//   6. Contact form (front-end only demo)
// ==========================================================================

(function () {
  "use strict";

  var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* 1. Mobile navigation toggle */
  var navToggle = document.getElementById("navToggle");
  var navMenu = document.getElementById("navMenu");

  function closeMenu() {
    navMenu.classList.remove("is-open");
    navToggle.setAttribute("aria-expanded", "false");
  }

  if (navToggle && navMenu) {
    navToggle.addEventListener("click", function () {
      var isOpen = navMenu.classList.toggle("is-open");
      navToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
    });

    navMenu.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", closeMenu);
    });
  }

  /* 2. Active nav-link highlighting */
  var sections = document.querySelectorAll(".stop[id]");
  var navLinks = document.querySelectorAll(".nav-menu a[href^='#']");

  function setActiveLink() {
    var scrollPos = window.scrollY + 120;
    var currentId = null;

    sections.forEach(function (section) {
      if (section.offsetTop <= scrollPos) {
        currentId = section.id;
      }
    });

    navLinks.forEach(function (link) {
      var targetId = link.getAttribute("href").replace("#", "");
      if (targetId === currentId) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  window.addEventListener("scroll", function () {
    requestAnimationFrame(setActiveLink);
  }, { passive: true });
  setActiveLink();

  /* 3. Skill bar reveal (fills once the Skills section enters view) */
  var tyreFills = document.querySelectorAll(".tyre-fill");
  var skillsSection = document.getElementById("skills");
  var filled = false;

  function fillTyres() {
    if (filled) return;
    filled = true;
    tyreFills.forEach(function (el) {
      el.style.width = el.getAttribute("data-pct") + "%";
    });
  }

  if ("IntersectionObserver" in window && !reduceMotion && skillsSection) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) fillTyres();
      });
    }, { threshold: 0.3 });
    io.observe(skillsSection);
  } else {
    fillTyres();
  }

  /* 4. Live-timing sidebar (sample data only — not a real timing feed) */
  var telSector = document.getElementById("telSector");
  var telTyreDot = document.getElementById("telTyreDot");
  var telTyreName = document.getElementById("telTyreName");
  var telTimer = document.getElementById("telTimer");

  var compounds = [
    { cls: "soft", name: "Soft" },
    { cls: "medium", name: "Medium" },
    { cls: "soft", name: "Soft" },
    { cls: "hard", name: "Hard" },
    { cls: "medium", name: "Medium" }
  ];
  var stops = document.querySelectorAll(".stop");

  function updateTelemetry() {
    if (!telSector) return;
    var refY = window.scrollY + window.innerHeight * 0.4;
    var idx = -1;

    stops.forEach(function (stop, i) {
      var top = stop.getBoundingClientRect().top + window.scrollY;
      if (refY >= top - 40) idx = i;
    });

    if (idx === -1) {
      telSector.textContent = "Formation Lap";
      telTyreDot.className = "tyre-dot soft";
      telTyreName.textContent = "Soft";
      return;
    }

    var label = stops[idx].querySelector(".board-label");
    telSector.textContent = label ? label.textContent : "Sector " + (idx + 1);

    var compound = compounds[idx % compounds.length];
    telTyreDot.className = "tyre-dot " + compound.cls;
    telTyreName.textContent = compound.name;
  }

  window.addEventListener("scroll", function () {
    requestAnimationFrame(updateTelemetry);
  }, { passive: true });
  updateTelemetry();

  var sessionStart = Date.now();
  function tickTimer() {
    if (!telTimer) return;
    var elapsed = Math.floor((Date.now() - sessionStart) / 1000);
    var m = Math.floor(elapsed / 60);
    var s = elapsed % 60;
    telTimer.textContent = (m < 10 ? "0" : "") + m + ":" + (s < 10 ? "0" : "") + s;
  }
  tickTimer();
  setInterval(tickTimer, 1000);

  /* 5. Liquid-glass tilt (skipped on touch devices and for reduced motion) */
  var isTouch = window.matchMedia("(hover: none)").matches;
  if (!reduceMotion && !isTouch) {
    document.querySelectorAll(".glass-card").forEach(function (card) {
      card.addEventListener("mouseenter", function () {
        card.classList.add("sheen");
      });
      card.addEventListener("mousemove", function (e) {
        var r = card.getBoundingClientRect();
        var px = (e.clientX - r.left) / r.width - 0.5;
        var py = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform =
          "perspective(900px) rotateX(" + (py * -4) + "deg) rotateY(" + (px * 5) + "deg)";
      });
      card.addEventListener("mouseleave", function () {
        card.style.transform = "perspective(900px) rotateX(0deg) rotateY(0deg)";
        setTimeout(function () { card.classList.remove("sheen"); }, 250);
      });
    });
  }

  /* 6. Contact form — front-end only for now */
  var contactForm = document.getElementById("contactForm");
  var formStatus = document.getElementById("formStatus");

  if (contactForm) {
    contactForm.addEventListener("submit", function (event) {
      event.preventDefault();
      formStatus.textContent =
        "Thanks! This form is a front-end demo for now — messages aren't sent yet.";
    });
  }
})();
  </script>
