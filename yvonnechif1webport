/* ==========================================================================
   Yvonne Margaret S. Chi — Portfolio
   Organized by section. Search the comment headers to jump to a part.
   ========================================================================== */

:root{
  --asphalt: #0e0f13;
  --chalk: #f5f5f7;
  --chalk-dim: #b7bac2;
  --red: #ff3b30;
  --amber: #ffc400;
  --green: #30d158;
  --glass-bg: rgba(255,255,255,0.07);
  --glass-bg-2: rgba(255,255,255,0.045);
  --glass-border: rgba(255,255,255,0.18);
  --gold: #d9b968;
  --font-ui: 'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;
  --font-display: 'Titillium Web', var(--font-ui);
  --header-height: 68px;
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
*,*::before,*::after{ box-sizing:inherit; }
html{
  scroll-behavior:smooth;
  scroll-padding-top: calc(var(--header-height) + env(safe-area-inset-top, 0px) + 12px);
}
body{
  margin:0;
  background:var(--asphalt);
  color:var(--chalk);
  font-family:var(--font-ui);
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
  position:relative;
}
body::before{
  content:'';
  position:fixed;
  inset:-10%;
  background:
    radial-gradient(circle at 12% 15%, rgba(150,45,45,.32), transparent 42%),
    radial-gradient(circle at 88% 10%, rgba(180,140,60,.26), transparent 45%),
    radial-gradient(circle at 25% 85%, rgba(40,110,90,.22), transparent 45%),
    radial-gradient(circle at 85% 75%, rgba(50,70,120,.24), transparent 42%);
  filter: blur(100px) saturate(120%);
  z-index:-2;
  pointer-events:none;
}
body::after{
  content:'';
  position:fixed;
  inset:0;
  background:rgba(14,15,19,.35);
  z-index:-1;
  pointer-events:none;
}
::selection{ background:var(--red); color:#fff; }
a{ color:inherit; }
img{ max-width:100%; display:block; }

/* ---------- Accessibility helpers ---------- */
.skip-link{
  position:fixed;
  left:12px; top:-60px;
  z-index:100;
  background:var(--chalk);
  color:var(--asphalt);
  font-family:var(--font-ui);
  font-weight:700;
  font-size:14px;
  padding:10px 16px;
  border-radius:8px;
  text-decoration:none;
  transition:top .15s ease;
}
.skip-link:focus{ top:12px; }

:focus-visible{
  outline:2px solid var(--amber);
  outline-offset:3px;
  border-radius:4px;
}

/* ---------- Site header / navigation ---------- */
.site-header{
  position:sticky;
  top:0;
  z-index:20;
  background:rgba(14,15,19,.55);
  backdrop-filter:blur(26px) saturate(180%);
  -webkit-backdrop-filter:blur(26px) saturate(180%);
  border-bottom:1px solid var(--glass-border);
}
.site-nav{
  max-width:1040px;
  margin:0 auto;
  padding:0 20px;
  height:var(--header-height);
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
}
.nav-brand{
  font-family:var(--font-display);
  font-weight:900;
  font-style:italic;
  font-size:20px;
  text-decoration:none;
  color:var(--chalk);
}
.nav-toggle{
  display:none;
  background:var(--glass-bg);
  border:1px solid var(--glass-border);
  color:var(--chalk);
  border-radius:10px;
  width:40px; height:40px;
  font-size:18px;
  cursor:pointer;
}
.nav-menu{
  list-style:none;
  display:flex;
  gap:6px;
  margin:0;
  padding:0;
}
.nav-menu a{
  display:inline-block;
  padding:9px 12px;
  border-radius:999px;
  text-decoration:none;
  font-weight:600;
  font-size:13.5px;
  color:var(--chalk-dim);
  transition:background .2s ease, color .2s ease;
  white-space:nowrap;
}
.nav-menu a:hover,
.nav-menu a:focus-visible{
  background:var(--glass-bg);
  color:var(--chalk);
}
.nav-menu a[aria-current="page"]{
  background:rgba(255,59,48,.5);
  color:#fff;
}

@media (max-width:980px){
  .nav-toggle{ display:block; }
  .nav-menu{
    position:absolute;
    top:100%; left:0; right:0;
    flex-direction:column;
    gap:2px;
    padding:10px 14px 16px;
    background:rgba(14,15,19,.92);
    backdrop-filter:blur(18px);
    border-bottom:1px solid var(--glass-border);
    display:none;
  }
  .nav-menu.is-open{ display:flex; }
  .nav-menu a{ padding:12px 14px; border-radius:10px; }
}

/* ---------- Layout shell ---------- */
.lane{
  position:relative;
  max-width:760px;
  margin:0 auto;
  padding:0 24px;
}

/* ---------- Hero ---------- */
.hero{
  position:relative;
  min-height:80vh;
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:70px 24px 60px;
  max-width:760px;
  margin:0 auto;
  text-align:left;
}
.lights{ display:flex; gap:14px; margin-bottom:36px; }
.lights span{
  width:16px; height:16px; border-radius:50%;
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.15);
  animation: lightUp 2.6s ease-in-out 1 both;
}
.lights span:nth-child(1){ animation-delay:.1s; }
.lights span:nth-child(2){ animation-delay:.4s; }
.lights span:nth-child(3){ animation-delay:.7s; }
.lights span:nth-child(4){ animation-delay:1.0s; }
.lights span:nth-child(5){ animation-delay:1.3s; }
@keyframes lightUp{
  0%{ background:rgba(255,255,255,.08); }
  8%{ background:var(--red); box-shadow:0 0 14px rgba(255,59,48,.8); }
  70%{ background:var(--red); box-shadow:0 0 14px rgba(255,59,48,.8); }
  85%{ background:var(--green); box-shadow:0 0 10px rgba(48,209,88,.6); }
  100%{ background:var(--green); box-shadow:0 0 10px rgba(48,209,88,.6); }
}
@media (prefers-reduced-motion: reduce){ .lights span{ animation:none; background:var(--green); } }

.eyebrow{
  display:inline-block;
  font-weight:600;
  letter-spacing:.12em;
  font-size:12px;
  color:var(--chalk);
  background:var(--glass-bg);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  border:1px solid var(--glass-border);
  padding:6px 14px;
  border-radius:999px;
  margin:0 0 20px;
  width:fit-content;
}
h1.name{
  font-family:var(--font-display);
  font-weight:900;
  font-style:italic;
  font-size:clamp(2.4rem, 7vw, 4.8rem);
  line-height:0.98;
  margin:0 0 18px;
  letter-spacing:-0.01em;
}
.tagline{
  font-size:clamp(1.05rem, 2vw, 1.25rem);
  color:var(--chalk-dim);
  max-width:52ch;
  line-height:1.55;
  margin:0 0 32px;
  font-weight:400;
}
.cta-row{ display:flex; gap:14px; flex-wrap:wrap; }
.btn{
  display:inline-flex; align-items:center; gap:8px;
  padding:14px 24px;
  font-weight:600; letter-spacing:.01em;
  font-size:15px;
  border-radius:999px;
  text-decoration:none;
  cursor:pointer;
  backdrop-filter:blur(16px) saturate(180%);
  -webkit-backdrop-filter:blur(16px) saturate(180%);
  transition:background .2s ease, transform .2s ease;
  border:none;
}
.btn:active{ transform:scale(.97); }
.btn-primary{ background:rgba(255,59,48,.55); border:1px solid rgba(255,255,255,.3); color:#fff; box-shadow:0 8px 24px rgba(255,59,48,.25), inset 0 1px 0 rgba(255,255,255,.3); }
.btn-primary:hover{ background:rgba(255,59,48,.7); }
.btn-ghost{ border:1px solid var(--glass-border); color:var(--chalk); background:var(--glass-bg); box-shadow:inset 0 1px 0 rgba(255,255,255,.2); }
.btn-ghost:hover{ background:rgba(255,255,255,.14); }

/* ---------- Sections ---------- */
.stops{ display:flex; flex-direction:column; gap:26px; padding-bottom:20px; }
.stop{ position:relative; padding:10px 0; scroll-margin-top: calc(var(--header-height) + 12px); }

.glass-card{
  position:relative;
  background:var(--glass-bg-2);
  backdrop-filter:blur(34px) saturate(190%);
  -webkit-backdrop-filter:blur(34px) saturate(190%);
  border:1px solid var(--glass-border);
  border-radius:30px;
  padding:34px 32px 38px;
  box-shadow:
    0 24px 60px rgba(0,0,0,.45),
    0 2px 0 rgba(255,255,255,.05),
    inset 0 1px 0 rgba(255,255,255,.28),
    inset 0 -18px 30px rgba(255,255,255,.03);
  overflow:hidden;
  transform:perspective(900px) rotateX(0deg) rotateY(0deg);
  transition:transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s ease;
  will-change:transform;
}
.glass-card::before{
  content:'';
  position:absolute; top:0; left:6%; right:6%; height:1px;
  background:linear-gradient(90deg, transparent, rgba(255,255,255,.65), transparent);
}
.glass-card::after{
  content:'';
  position:absolute; inset:0;
  background:linear-gradient(115deg, transparent 30%, rgba(255,255,255,.12) 45%, transparent 60%);
  transform:translateX(-120%);
  pointer-events:none;
}
.glass-card.sheen::after{ transition:transform .7s ease; transform:translateX(120%); }
@media (max-width:640px){ .glass-card{ padding:26px 22px 30px; border-radius:24px; } }
@media (prefers-reduced-motion: reduce){ .glass-card{ transition:none; } .glass-card.sheen::after{ transition:none; transform:translateX(120%); } }

.about-grid{ display:flex; gap:28px; align-items:flex-start; }
@media (max-width:640px){ .about-grid{ flex-direction:column; align-items:center; text-align:center; } }
.profile-photo{
  flex:none;
  width:116px; height:116px;
  border-radius:50%;
  overflow:hidden;
  border:1px solid var(--glass-border);
  box-shadow:0 0 0 5px rgba(255,255,255,.05), 0 14px 30px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.3);
  background:var(--glass-bg);
}
.profile-photo img,
.profile-photo svg{ width:100%; height:100%; object-fit:cover; display:block; }

.board-label{
  display:inline-block;
  font-weight:600;
  font-size:12px;
  letter-spacing:.12em;
  color:var(--asphalt);
  background:var(--amber);
  padding:5px 12px;
  border-radius:999px;
  margin-bottom:18px;
}
h2.stop-title{
  font-family:var(--font-display);
  font-weight:700;
  font-size:clamp(1.6rem, 4vw, 2.2rem);
  margin:0 0 18px;
}
.stop p{
  color:var(--chalk-dim);
  line-height:1.65;
  font-size:1rem;
  max-width:62ch;
  margin:0 0 14px;
  font-weight:400;
}

/* Info grid */
.info-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));
  gap:12px;
  margin:22px 0 0;
  padding:0;
}
.info-item{
  background:var(--glass-bg);
  backdrop-filter:blur(18px) saturate(170%);
  -webkit-backdrop-filter:blur(18px) saturate(170%);
  border:1px solid var(--glass-border);
  border-radius:16px;
  padding:14px 16px;
}
.info-item dt{
  font-size:10.5px;
  font-weight:700;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:var(--chalk-dim);
  margin:0 0 6px;
}
.info-item dd{
  margin:0;
  font-size:14.5px;
  font-weight:600;
  line-height:1.4;
}

.chip-row{ display:flex; gap:8px; flex-wrap:wrap; margin-top:18px; }
.chip{
  font-size:12.5px; font-weight:600;
  background:var(--glass-bg); border:1px solid var(--glass-border);
  border-radius:999px; padding:6px 13px; color:var(--chalk-dim);
}

.group-heading{
  font-family:var(--font-ui);
  font-size:13px; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
  color:var(--amber);
  margin:24px 0 4px;
}
.stop .glass-card > .group-heading:first-of-type{ margin-top:22px; }

.quote-banner{
  max-width:600px;
  margin:6px auto 0;
  text-align:center;
  padding:26px 30px;
  background:var(--glass-bg);
  backdrop-filter:blur(20px) saturate(170%);
  -webkit-backdrop-filter:blur(20px) saturate(170%);
  border:1px solid var(--glass-border);
  border-radius:22px;
}
.quote-text{
  font-family:var(--font-display);
  font-style:italic;
  font-weight:700;
  font-size:clamp(1.05rem, 2.4vw, 1.3rem);
  line-height:1.4;
  margin:0 0 10px;
  color:var(--chalk);
}
.quote-attr{ margin:0; font-size:13px; color:var(--amber); font-weight:600; }

/* Skills */
.tyres{ display:grid; gap:18px; margin:26px 0 0; padding:0; list-style:none; max-width:520px; }
.tyre-row{ display:grid; grid-template-columns:120px 1fr 40px; align-items:center; gap:14px; }
.tyre-name{ font-weight:600; font-size:14px; }
.tyre-track{ display:block; height:8px; background:rgba(255,255,255,.1); border-radius:4px; overflow:hidden; }
.tyre-fill{ display:block; height:100%; border-radius:4px; background:linear-gradient(90deg, var(--red), var(--amber)); width:0%; transition:width 1.1s cubic-bezier(.2,.8,.2,1); }
.tyre-pct{ font-weight:700; font-size:13px; color:var(--chalk-dim); text-align:right; }

/* Projects */
.results{ display:grid; gap:12px; margin:22px 0 0; padding:0; list-style:none; }
.result-row{
  display:grid;
  grid-template-columns:34px 1fr auto;
  gap:16px;
  align-items:start;
  padding:18px 20px;
  background:var(--glass-bg);
  backdrop-filter:blur(18px) saturate(170%);
  -webkit-backdrop-filter:blur(18px) saturate(170%);
  border:1px solid var(--glass-border);
  border-left:3px solid var(--red);
  border-radius:16px;
}
.pos{ font-family:var(--font-display); font-weight:900; font-style:italic; font-size:19px; color:var(--amber); }
.result-row h3{ font-size:16.5px; font-weight:600; margin:0 0 6px; }
.result-row p{ margin:0; font-size:14px; }
.result-row .stack{ font-size:11.5px; font-weight:600; color:var(--amber); letter-spacing:.05em; margin-top:8px; }
.lap-time{ font-weight:700; font-size:12.5px; color:var(--chalk-dim); white-space:nowrap; }

/* Timeline / lists (journey, involvement, achievements) */
.standings{ margin:22px 0 0; padding:0; list-style:none; border-top:1px solid rgba(255,255,255,.12); }
.standing-row{ display:grid; grid-template-columns:1fr auto; gap:12px; padding:16px 4px; border-bottom:1px solid rgba(255,255,255,.12); }
.standing-role{ font-weight:600; font-size:16px; margin:0; }
.standing-org{ color:var(--chalk-dim); font-size:14px; margin:2px 0 0; }
.standing-years{ font-weight:700; font-size:12.5px; color:var(--gold); white-space:nowrap; }

/* Contact */
.radio{ margin-top:22px; display:grid; gap:10px; max-width:420px; }
.radio a{
  display:flex; justify-content:space-between; align-items:center;
  padding:15px 18px;
  background:var(--glass-bg);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  border:1px solid var(--glass-border);
  border-radius:14px;
  text-decoration:none;
  font-weight:600;
  font-size:15px;
  transition:background .2s ease;
}
.radio a:hover{ background:rgba(255,255,255,.13); }
.radio a span.arrow{ color:var(--amber); }

.contact-form{ margin-top:28px; display:grid; gap:16px; max-width:460px; }
.form-field{ display:flex; flex-direction:column; gap:6px; }
.form-field label{ font-size:13px; font-weight:600; color:var(--chalk-dim); }
.form-field input,
.form-field textarea{
  font-family:var(--font-ui);
  font-size:15px;
  color:var(--chalk);
  background:var(--glass-bg);
  border:1px solid var(--glass-border);
  border-radius:12px;
  padding:12px 14px;
  resize:vertical;
}
.form-field input::placeholder,
.form-field textarea::placeholder{ color:rgba(245,245,247,.4); }
.form-note{ font-size:12.5px; color:rgba(245,245,247,.5); margin:0; }

footer{
  text-align:left; padding:40px 24px 60px; max-width:760px; margin:0 auto;
  color:var(--chalk-dim); font-size:13px;
}
.note{
  max-width:760px; margin:0 auto; padding:14px 24px 0;
  font-size:12.5px; color:rgba(245,245,247,.45);
}

/* ---------- Live timing sidebar ---------- */
.telemetry{
  position:fixed;
  z-index:5;
  background:var(--glass-bg-2);
  backdrop-filter:blur(30px) saturate(190%);
  -webkit-backdrop-filter:blur(30px) saturate(190%);
  border:1px solid var(--glass-border);
  box-shadow:0 16px 48px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.3);
  color:var(--chalk);
}
@media (min-width:1100px){
  .telemetry{
    right:28px; top:50%; transform:translateY(-50%);
    width:196px; border-radius:20px; padding:20px 20px 22px;
    display:flex; flex-direction:column; gap:14px;
  }
}
@media (max-width:1099px){
  .telemetry{
    left:12px; right:12px; bottom:12px;
    border-radius:18px; padding:12px 16px;
    display:flex; align-items:center; justify-content:space-between; gap:10px;
  }
  .telemetry-driver{ display:none; }
}
.telemetry-header{ display:flex; align-items:center; gap:8px; font-size:11px; font-weight:700; letter-spacing:.12em; color:var(--chalk-dim); }
.telemetry-header .dot{ width:7px; height:7px; border-radius:50%; background:var(--red); box-shadow:0 0 8px rgba(255,59,48,.8); animation:blinkDot 1.6s ease-in-out infinite; }
@keyframes blinkDot{ 0%,100%{opacity:1;} 50%{opacity:.55;} }
@media (prefers-reduced-motion: reduce){ .telemetry-header .dot{ animation:none; } }
.telemetry-driver{ display:flex; align-items:baseline; gap:8px; }
.telemetry-driver .tnum{ font-family:var(--font-display); font-weight:900; font-style:italic; font-size:22px; color:var(--amber); }
.telemetry-driver .tname{ font-weight:700; font-size:14px; letter-spacing:.02em; }
.telemetry-row{ display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:12.5px; }
.telemetry-row .label{ color:var(--chalk-dim); letter-spacing:.06em; text-transform:uppercase; font-size:10px; font-weight:600; }
.telemetry-row .value{ font-weight:600; }
.telemetry-row .value.mono{ font-variant-numeric:tabular-nums; }
.tyre-chip{ display:flex; align-items:center; gap:6px; }
.tyre-dot{ width:12px; height:12px; border-radius:50%; border:2px solid rgba(255,255,255,.55); flex:none; }
.tyre-dot.soft{ background:var(--red); }
.tyre-dot.medium{ background:var(--amber); }
.tyre-dot.hard{ background:#fff; }
  </style>
</head>
